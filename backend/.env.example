# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://tracker:tracker@localhost:5432/task_tracker?schema=public"

# Access token — short lived, returned in the response body.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token — long lived, stored hashed in DB, set as httpOnly cookie.
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin — used for CORS and email verification / password-reset links.
# Must be exact (not *) because cookies are involved (credentials: true).
FRONTEND_ORIGIN="http://localhost:3000"

PORT=3001
NODE_ENV="development"

# Socket.io multi-pod pub/sub (not an HTTP cache). Leave empty for local
# single-process npm run start:dev. Required in Docker Compose / Kubernetes
# when backend HPA can scale above 1 replica.
# REDIS_URL="redis://localhost:6379"

# Internal URL of the Python RAG assistant microservice (ClusterIP in k8s).
# AI_ASSISTANT_URL="http://localhost:8000"

# ── Optional: Google OAuth ──
# Create an OAuth 2.0 Client (Web) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly
# (the Next.js BFF callback, not the Nest URL):
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ── Email (verification + password reset) ──
# Railway Hobby/Free blocks outbound SMTP (ports 25/465/587). Use Resend HTTPS:
#   https://resend.com → API key. For testing, MAIL_FROM can be:
#   Task Tracker <onboarding@resend.dev>
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM="Task Tracker <onboarding@resend.dev>"
#
# Local / Pro plan may use SMTP instead (Mailtrap, Gmail App Password, …):
# MAIL_HOST="sandbox.smtp.mailtrap.io"
# MAIL_PORT="2525"
# MAIL_USER=""
# MAIL_PASS=""
# MAIL_FROM="Task Tracker <noreply@localhost>"
