# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://tracker:tracker@localhost:5432/task_tracker?schema=public"

# Access token — short lived, returned in the response body.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token — long lived, stored hashed in DB, set as httpOnly cookie.
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin — used for CORS and email verification / password-reset links.
# Must be exact (not *) because cookies are involved (credentials: true).
FRONTEND_ORIGIN="http://localhost:3000"

PORT=3001
NODE_ENV="development"

# ── Optional: Google OAuth ──
# Create an OAuth 2.0 Client (Web) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly
# (the Next.js BFF callback, not the Nest URL):
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ── SMTP for verification + password reset (required for email/password signup) ──
# Must be a real sending relay — sandbox catchers (Mailtrap Email Testing) do NOT
# deliver to the user's inbox. Use Gmail App Password, Resend SMTP, SendGrid, or
# Mailtrap Email Sending.
# MAIL_HOST="smtp.resend.com"
# MAIL_PORT="587"
# MAIL_USER=""
# MAIL_PASS=""
# MAIL_FROM="Task Tracker <noreply@yourdomain.com>"
