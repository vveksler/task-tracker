# Same Postgres as Nest (must support pgvector: CREATE EXTENSION vector).
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/task_tracker"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
# Shared secret for /internal/* — must equal the backend value (min 32 chars).
# Generate: openssl rand -hex 32
AI_ASSISTANT_INTERNAL_TOKEN="change-me-to-a-random-32+-char-secret"
# Optional model overrides:
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_MODEL=claude-sonnet-4-6
# Railway sets PORT automatically; local default is 8000.
# PORT=8000
