{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: start dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "${workspaceFolder}/.vscode/run-npm.sh",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack://./src/*": "${webRoot}/src/*",
        "turbopack://[project]/*": "${webRoot}/*"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Next.js: attach router (9230)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "timeout": 60000,
      "restart": true,
      "cwd": "${workspaceFolder}/frontend",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack://./src/*": "${webRoot}/src/*",
        "turbopack://[project]/*": "${webRoot}/*"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "NestJS: debug backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/.vscode/run-npm.sh",
      "runtimeArgs": ["run", "start:debug"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "AI Assistant: debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/ai-assistant",
      "runtimeExecutable": "${workspaceFolder}/.vscode/run-npm.sh",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Jest: debug backend tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/.vscode/run-npm.sh",
      "runtimeArgs": ["test", "--", "--runInBand"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Jest: debug frontend tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "${workspaceFolder}/.vscode/run-npm.sh",
      "runtimeArgs": ["test", "--", "--runInBand"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Next.js: debug frontend",
      "configurations": ["Next.js: start dev", "Next.js: attach router (9230)"],
      "stopAll": true
    },
    {
      "name": "Full Stack: frontend + backend",
      "configurations": [
        "Next.js: start dev",
        "Next.js: attach router (9230)",
        "NestJS: debug backend"
      ],
      "stopAll": true
    },
    {
      "name": "Full Stack: frontend + backend + AI",
      "configurations": [
        "Next.js: start dev",
        "Next.js: attach router (9230)",
        "NestJS: debug backend",
        "AI Assistant: debug"
      ],
      "stopAll": true
    }
  ]
}
