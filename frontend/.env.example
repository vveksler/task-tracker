# Copy to .env.local

NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Optional: absolute app origin used in OAuth redirects (defaults to request host).
# On Railway prefer setting this; also used as Docker build context for NEXT_PUBLIC_*.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Runtime-only alias (not baked at build) — useful in production:
# APP_URL="https://frontend-production-xxxx.up.railway.app"

# Optional: internal URL for server-side calls (e.g. in Docker/K8s
# where backend is reachable via service name instead of localhost)
# BACKEND_INTERNAL_URL="http://backend:3001"

# ── Optional: Google OAuth (BFF start redirect) ──
# Same Client ID as backend. Secret stays on the Nest backend only.
# Callback URL must match Google Console + backend GOOGLE_CALLBACK_URL:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
