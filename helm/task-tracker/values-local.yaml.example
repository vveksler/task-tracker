# Copy to values-local.yaml (gitignored) and fill in real secrets.
# Usage:
#   helm upgrade --install task-tracker helm/task-tracker -n task-tracker \
#     -f helm/task-tracker/values.yaml \
#     -f helm/task-tracker/values-local.yaml
# Or: ./scripts/minikube-deploy.sh

# For Google OAuth local testing (Google rejects *.local redirect URIs):
appUrl: "http://localhost:3000"

google:
  clientId: "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  clientSecret: "YOUR_GOOGLE_CLIENT_SECRET"
  callbackUrl: "http://localhost:3000/api/auth/google/callback"

# Local: Mailtrap SMTP is fine (caught in Mailtrap UI, not real Gmail).
# Railway Hobby: SMTP is blocked — use RESEND_API_KEY instead (see README).
mail:
  host: "sandbox.smtp.mailtrap.io"
  port: "2525"
  user: "YOUR_MAILTRAP_USER"
  pass: "YOUR_MAILTRAP_PASS"
  from: "Task Tracker <noreply@localhost>"
  # resendApiKey: "re_xxxxxxxx"

# RAG assistant (in-cluster). After deploy, enable per workspace:
#   DATABASE_URL=... npx ts-node scripts/enable-ai-assistant.ts <workspaceId>
aiAssistant:
  enabled: true
  openaiApiKey: "sk-..."
  anthropicApiKey: "sk-ant-..."
